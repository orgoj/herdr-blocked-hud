# Project tools: tests, headless GUI tests, Backlog.md and read-only Herdr queries.
allow python3 -m unittest *
allow python3 -m pytest *
allow python3 *.py *
allow python3 ./** *
allow python3 tests/run *
allow python3 tests/run|
allow python3 bin/herdr-blocked-hud *
deny python3 ./tmp/** "Running scripts from tmp/ is not allowed: put the code in the project and run it from there"
allow xvfb-run python3 tests/run *
allow xvfb-run python3 tests/run|
allow xvfb-run -a python3 tests/run *
allow xvfb-run -a python3 tests/run|
allow xvfb-run -a python3 -m unittest *
allow backlog *
allow herdr pane list *
allow herdr pane list|
allow herdr pane get *
allow herdr pane current *
allow herdr pane current|
allow herdr agent list *
allow herdr agent list|
allow herdr agent get *
allow herdr workspace list *
allow herdr workspace list|
allow herdr tab list *
allow herdr tab list|
allow herdr status *
allow herdr status|
allow herdr --version|
