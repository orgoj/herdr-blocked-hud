#!/usr/bin/env python3
"""Set the release version: bin/bump-version X.Y.Z

Updates the version in pyproject.toml and the install tag in README.md.
Rejects a malformed version or one not newer than the current one, and then
changes no file.
"""

import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
VERSION = re.compile(r"(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)")
PYPROJECT = re.compile(r'^version = "([^"]*)"$', re.M)
README_TAG = re.compile(r"(herdr-blocked-hud@v)(\S+)")


def parse(version):
    match = VERSION.fullmatch(version)
    return tuple(map(int, match.groups())) if match else None


def replace_once(pattern, text, repl, name):
    new, count = pattern.subn(repl, text)
    if count != 1:
        raise SystemExit(f"bump-version: expected one version in {name}, found {count}")
    return new


def main(argv):
    if len(argv) != 1:
        raise SystemExit("usage: bin/bump-version X.Y.Z")
    new = argv[0]
    if parse(new) is None:
        raise SystemExit(f"bump-version: malformed version {new!r}, expected X.Y.Z")
    pyproject_path = ROOT / "pyproject.toml"
    readme_path = ROOT / "README.md"
    pyproject = pyproject_path.read_text()
    readme = readme_path.read_text()
    current = PYPROJECT.findall(pyproject)
    if len(current) != 1 or parse(current[0]) is None:
        raise SystemExit(f"bump-version: cannot read the current version in {pyproject_path}")
    if parse(new) <= parse(current[0]):
        raise SystemExit(f"bump-version: {new} is not newer than {current[0]}")
    pyproject = replace_once(PYPROJECT, pyproject, f'version = "{new}"', pyproject_path)
    readme = replace_once(README_TAG, readme, rf"\g<1>{new}", readme_path)
    pyproject_path.write_text(pyproject)
    readme_path.write_text(readme)
    print(f"{current[0]} -> {new}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
